# OpenVibe.Markets (plan §L.1). No database, no sign-in, nothing kept.
PORT=5294
HOST=127.0.0.1
# Deals' API over loopback (GET /api/v1/search, Deals #380).
DEALS_URL=http://127.0.0.1:4840
DEALS_TIMEOUT_MS=5000
# Search by photo (Network #1118: client 'markets', grant vision.image.ask). Off without the secret.
OV_OAUTH_CLIENT_ID=markets
OV_OAUTH_CLIENT_SECRET=
OV_NETWORK_INTERNAL_URL=http://127.0.0.1:4000
VISION_URL=http://127.0.0.1:5130
